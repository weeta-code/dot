[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "j k": "vim::NormalBefore"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "space g h": "git_panel::ToggleFocus",
      "space g c": "git_panel::Close",
      "space e e": "project_panel::ToggleFocus",
      "space f s": "pane::DeploySearch",
    }
  },
  {
    "context": "ProjectSearchBar",
    "bindings": {
      "space f s": "search::FocusSearch"
    }
  }
]