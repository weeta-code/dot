# Dotfiles Brewfile - macOS system dependencies
# Run: brew bundle --file=~/.config/Brewfile

# Taps (must come first)
tap "nikitabobko/tap"
tap "FelixKratz/formulae"

# Build tools
brew "gdb"
brew "cmake"
brew "make"
brew "llvm"

# CLI tools
brew "tree"
brew "wget"
brew "zoxide"
brew "stow"
brew "sesh"

# Window management
brew "borders"
brew "sketchybar"

# Casks (macOS apps)
cask "font-hack-nerd-font"
cask "aerospace"
cask "ghostty"
